<!--
  FAQAT DEBUG BUILD UCHUN. `src/debug/` da yotgani uchun release APK ga
  umuman tushmaydi — u yerda Android 9+ ning standart "cleartext taqiqlanadi"
  siyosati kuchida qoladi.

  Sabab: lokal backend http://10.0.2.2:8080 da ishlaydi (TLS yo'q).
  Busiz Dio "CLEARTEXT communication to 10.0.2.2 not permitted" xatosi beradi.

  10.0.2.2  — Android emulyatordan xost mashinaga alias (localhost EMAS).
  10.0.3.2  — Genymotion uchun shu maqsadda.
  localhost — `adb reverse tcp:8080 tcp:8080` ishlatilganda.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
